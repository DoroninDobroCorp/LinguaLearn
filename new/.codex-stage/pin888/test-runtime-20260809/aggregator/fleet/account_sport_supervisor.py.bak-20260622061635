"""Per-account multi-sport fleet supervisor.

One account owns one browser session, and that browser keeps several sport WS
tabs warm. This preserves account-level MORE_BET budgeting without forcing one
account to be idle for five of six sports.
"""

from __future__ import annotations

import asyncio
import logging
import time
from datetime import datetime, timezone
from typing import Any, Callable, Type

from aggregator.account_pool import AccountPool, FleetAccount, FleetAccountPool, replacements_needed
from aggregator.fleet.sport_allocation import SportSpec, profile_for_sport
from aggregator.fleet.supervisor import _log_worker_stats, assign_ports, classify_failure
from aggregator.fleet.worker import MultiSportWorker


_LOG = logging.getLogger(__name__)


def assign_sports_to_accounts(
    accounts: list[FleetAccount],
    sports: list[SportSpec],
    assignment_spec: str | None = None,
) -> dict[str, list[SportSpec]]:
    """Assign sport tabs to account ids.

    assignment_spec format:
      account-a=soccer,basketball;account-b=tennis,e-sports

    Missing/unknown sports fall back to the round-robin assignment so a typo
    does not silently drop a sport.
    """
    if not accounts:
        return {}
    out: dict[str, list[SportSpec]] = {acc.id: [] for acc in accounts}
    sport_by_slug = {sport.slug: sport for sport in sports}
    assigned: set[str] = set()
    if assignment_spec:
        account_ids = set(out)
        for chunk in assignment_spec.split(";"):
            chunk = chunk.strip()
            if not chunk or "=" not in chunk:
                continue
            account_id, raw_slugs = chunk.split("=", 1)
            account_id = account_id.strip()
            if account_id not in account_ids:
                continue
            for raw_slug in raw_slugs.split(","):
                slug = raw_slug.strip()
                sport = sport_by_slug.get(slug)
                if sport is None or slug in assigned:
                    continue
                out[account_id].append(sport)
                assigned.add(slug)
    remaining = [sport for sport in sports if sport.slug not in assigned]
    if not remaining:
        return out
    for idx, sport in enumerate(remaining):
        out[accounts[idx % len(accounts)].id].append(sport)
    return out


class AccountSportFleetSupervisor:
    """Maintain one multi-sport worker per active account."""

    def __init__(
        self,
        *,
        accounts: list[FleetAccount],
        sports: list[SportSpec],
        on_event: Callable[[dict[str, Any]], None],
        worker_run_sec: float = 600.0,
        watchlist_provider: Callable[[], list[int]] | None = None,
        canonical_pool: AccountPool | None = None,
        on_raw_frame: Callable[[dict[str, Any]], None] | None = None,
        next_morebet_target: Callable[[], int | None] | None = None,
        cdp_base: int = 9300,
        socks_base: int = 19300,
        assignment_spec: str | None = None,
        _worker_cls: Type[MultiSportWorker] | None = None,
    ) -> None:
        if not accounts:
            raise ValueError("AccountSportFleetSupervisor requires at least one account")
        if not sports:
            raise ValueError("AccountSportFleetSupervisor requires at least one sport")
        self.accounts = list(accounts)
        self.sports = list(sports)
        self.pool = FleetAccountPool(self.accounts, success_cooldown_sec=0.0)
        self.assignment = assign_sports_to_accounts(self.accounts, self.sports, assignment_spec)
        self.on_event = on_event
        self.worker_run_sec = float(worker_run_sec)
        self.watchlist_provider = watchlist_provider
        self.canonical_pool = canonical_pool
        self.on_raw_frame = on_raw_frame
        self.next_morebet_target = next_morebet_target
        self.cdp_base = cdp_base
        self.socks_base = socks_base
        self._worker_cls: Type[MultiSportWorker] = _worker_cls or MultiSportWorker
        self.target_k = len([acc for acc in self.accounts if self.assignment.get(acc.id)])
        self.spawned = 0
        self.swaps = 0
        self.failures: list[dict[str, Any]] = []
        self._slot_seq = 0

    def _reserve_morebet(self, account_id: str) -> bool:
        if self.canonical_pool is None:
            return True
        return self.canonical_pool.reserve_more_bet(account_id)

    def _spawn(self, now: float) -> asyncio.Task[dict[str, Any]] | None:
        acc = self.pool.acquire(now)
        if acc is None:
            return None
        sports = self.assignment.get(acc.id) or []
        if not sports:
            self.pool.release(now, acc.id, "ok")
            return None
        slot = self._slot_seq
        self._slot_seq += 1
        cdp, socks = assign_ports(slot, cdp_base=self.cdp_base, socks_base=self.socks_base)
        cfg: dict[str, Any] = dict(acc.cfg)
        cfg.setdefault("cdp", cdp)
        cfg.setdefault("socks", socks)
        cfg.setdefault("profile", profile_for_sport(acc.id, "multi", 0, slot))

        worker_kwargs: dict[str, Any] = {
            "label": acc.id,
            "sports": sports,
            "on_event": self.on_event,
            "cfg": cfg,
            "reserve_morebet": self._reserve_morebet,
        }
        if self.on_raw_frame is not None:
            worker_kwargs["on_raw_frame"] = self.on_raw_frame
        if self.next_morebet_target is not None:
            worker_kwargs["next_morebet_target"] = self.next_morebet_target
        worker = self._worker_cls(**worker_kwargs)
        self.spawned += 1
        watchlist = self.watchlist_provider() if self.watchlist_provider is not None else []
        task: asyncio.Task[dict[str, Any]] = asyncio.ensure_future(
            worker.run(self.worker_run_sec, watchlist)
        )
        setattr(task, "_acc_id", acc.id)
        setattr(task, "_sport_slugs", [sport.slug for sport in sports])
        _LOG.info(
            "account-sports worker start acc=%s sports=%s slot=%s",
            acc.id,
            [sport.slug for sport in sports],
            slot,
        )
        return task

    async def _wait_for_reserve(self, now: float, start: float, total_sec: float, stop_event: Any) -> None:
        next_at = self.pool.next_available_at(now)
        wait_sec = 1.0 if next_at is None else max(0.05, min(1.0, next_at - now))
        if total_sec != float("inf"):
            wait_sec = min(wait_sec, max(0.0, total_sec - (now - start)))
        if stop_event is not None and stop_event.wait(timeout=wait_sec):
            return
        await asyncio.sleep(0 if stop_event is not None else wait_sec)

    async def run(
        self,
        total_sec: float,
        stop_event: Any = None,
        _clock: Callable[[], float] = time.time,
    ) -> dict[str, Any]:
        start = _clock()
        tasks: set[asyncio.Task[dict[str, Any]]] = set()
        for _ in range(min(self.target_k, max(1, self.pool.reserve_count(_clock())))):
            task = self._spawn(_clock())
            if task is not None:
                tasks.add(task)

        def _should_stop() -> bool:
            if stop_event is not None and stop_event.is_set():
                return True
            return _clock() - start >= total_sec

        while not _should_stop():
            if tasks:
                done, pending = await asyncio.wait(
                    tasks, timeout=10.0, return_when=asyncio.FIRST_COMPLETED
                )
                tasks = set(pending)
            else:
                done = set()
            now = _clock()
            for task in done:
                acc_id: str = getattr(task, "_acc_id", "?")
                sport_slugs: list[str] = getattr(task, "_sport_slugs", [])
                try:
                    res = task.result()
                    status = str(res.get("status", "FAIL: unknown"))
                except Exception as exc:
                    res = {}
                    status = "FAIL: %s" % str(exc)[:80]
                _log_worker_stats(_LOG, acc_id, status, res)
                reason = classify_failure(status)
                self.pool.release(now, acc_id, reason)
                if reason == "lockout" and self.canonical_pool is not None:
                    self.canonical_pool.report_outcome(
                        acc_id,
                        "429",
                        datetime.now(timezone.utc),
                    )
                self.failures.append(
                    dict(acc=acc_id, sports=sport_slugs, status=status, reason=reason)
                )

            need = replacements_needed(
                self.target_k,
                healthy_active=len(tasks),
                reserve=self.pool.reserve_count(now),
            )
            for _ in range(need):
                task = self._spawn(now)
                if task is not None:
                    tasks.add(task)
                    self.swaps += 1
            if not tasks and not _should_stop():
                await self._wait_for_reserve(_clock(), start, total_sec, stop_event)

        if tasks:
            done, pending = await asyncio.wait(tasks, timeout=3.0)
            for task in done:
                acc_id = getattr(task, "_acc_id", "?")
                try:
                    res = task.result()
                    status = str(res.get("status", "FAIL: unknown"))
                except Exception as exc:
                    res = {}
                    status = "FAIL: %s" % str(exc)[:80]
                _log_worker_stats(_LOG, acc_id, status, res)
            for task in pending:
                task.cancel()
            if pending:
                await asyncio.gather(*pending, return_exceptions=True)

        now = _clock()
        return dict(
            target_k=self.target_k,
            sports=[dict(slug=s.slug, sport_id=s.sport_id) for s in self.sports],
            assignment={acc: [sport.slug for sport in sports] for acc, sports in self.assignment.items()},
            spawned=self.spawned,
            swaps=self.swaps,
            pool=self.pool.snapshot(now),
            failures=self.failures,
        )


__all__ = ["AccountSportFleetSupervisor", "assign_sports_to_accounts"]
