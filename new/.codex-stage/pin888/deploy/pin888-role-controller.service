[Unit]
Description=Reconcile Pin888 football and other-sports ownership
After=network-online.target ps38-aggregator.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/srv/pin888/bin/check-no-pinnacle-api
ExecStart=/usr/bin/python3 /srv/pin888/bin/pin888-role-controller --tick --rotation-sec 28800
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
