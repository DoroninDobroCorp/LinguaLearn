[Unit]
Description=PS38 MoreBets aggregator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin805
Group=admin805
WorkingDirectory=/srv/ps38-aggregator/current
EnvironmentFile=/srv/ps38-aggregator/env/ps38-aggregator.env
ExecStartPre=/srv/pin888/bin/check-no-pinnacle-api
ExecStart=/srv/ps38-aggregator/current/.venv/bin/python -u -m aggregator.main
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
