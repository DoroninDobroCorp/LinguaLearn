[Unit]
Description=PNCL live event fallback proxy
After=network.target pncl.service
Wants=pncl.service

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/srv/sharpbook/app
Environment=LIVE_FALLBACK_HOST=127.0.0.1
Environment=LIVE_FALLBACK_PORT=8082
Environment=PNCL_UPSTREAM=http://127.0.0.1:8081
Environment=PIN_WS_HOST=127.0.0.1
Environment=PIN_WS_PORT=9014
Environment=PINNACLE_API_BASE=http://127.0.0.1:8770
Environment=PINNACLE_REAL_PLACE_ENABLED=0
Environment=PNCL_REAL_PLACE_ENABLED=0
Environment=REAL_PLACE_ENABLED=0
ExecStart=/usr/bin/python3 /srv/sharpbook/app/live_event_fallback.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
