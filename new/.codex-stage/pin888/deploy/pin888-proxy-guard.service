[Unit]
Description=Stop Pin888 accounts when their mandatory SOCKS5 route is unhealthy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/srv/pin888/bin/check-no-pinnacle-api
ExecStart=/srv/pin888/bin/check-pin888-proxies --proxies /home/admin805/.secrets/pin888_active_proxies.txt --manage-unit pin888-role-fleet.service --role-state /var/lib/pin888-role-controller/state.json

[Install]
WantedBy=multi-user.target
