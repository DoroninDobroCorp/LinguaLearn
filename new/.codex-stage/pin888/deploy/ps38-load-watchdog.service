[Unit]
Description=PS38 load watchdog — restart aggregator when server is overloaded

[Service]
Type=oneshot
User=root
EnvironmentFile=-/srv/ps38-aggregator/env/ps38-aggregator.env
ExecStart=/srv/ps38-aggregator/current/.venv/bin/python /srv/ps38-aggregator/bin/ps38_load_watchdog.py
MemoryMax=128M
OOMScoreAdjust=1000
RuntimeMaxSec=60

[Install]
WantedBy=multi-user.target
