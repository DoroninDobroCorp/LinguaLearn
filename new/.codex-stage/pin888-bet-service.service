[Unit]
Description=Pin888 betslip gateway using the active parser-owned session
After=network-online.target pin888-remote-fleet.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ps38-remote-fleet/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/ps38-remote-fleet/current
Environment=BET_SERVICE_HOSTS=127.0.0.1,172.21.0.1
Environment=BET_SERVICE_PORT=8769
Environment=SESSION_FILE=/var/lib/ps38-remote-fleet/sessions/evanosochik8.json
Environment=PS3838_BET_SERVICE_OWN_SESSION=0
Environment=PS3838_PARSER_SESSION_MAX_AGE_SEC=180
Environment=PS3838_PARSER_URL=http://127.0.0.1:19013
# Pinnacle API is intentionally not used as a parser source.
Environment=MSP_PINNACLE_API_ENABLED=0
# Real placement is available, but only with a fresh parser-owned session.
Environment=ENABLE_BETTING=true
Environment=DRY_RUN=false
Environment=MAX_ALLOWED_STAKE=100
# BIA remains the central MoreBets/price-check source. This local gateway does
# not duplicate BIA credentials or create a second BIA login.
Environment=PS3838_VERIFY_EXACT_PRICE_ENABLED=0
ExecStart=/opt/ps38-remote-fleet/current/.venv/bin/python -u services/bet_service.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ps38-remote-fleet/sessions

[Install]
WantedBy=multi-user.target
