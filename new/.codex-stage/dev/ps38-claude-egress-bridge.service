[Unit]
Description=PS38 Claude loopback HTTP to dedicated SOCKS bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
LimitCORE=0
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
Environment=PS38_CLAUDE_BRIDGE_HOST=127.0.0.1
Environment=PS38_CLAUDE_BRIDGE_PORT=19011
Environment=PS38_CLAUDE_PROXY_DB=/var/lib/ps38-claude/ai-queue.db
Environment=PS38_CLAUDE_PROVIDER=subscription@ps38-dev
Environment=PS38_CLAUDE_ALLOWED_CONNECT_PORTS=443
Environment=PS38_CLAUDE_ALLOWED_CONNECT_HOSTS=anthropic.com,.anthropic.com,claude.ai,.claude.ai,claude.com,.claude.com
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -r /var/lib/ps38-claude/ai-queue.db
ExecStart=/srv/ps38-claude/current/venv/bin/python /srv/ps38-claude/current/bin/ps38-http-socks-bridge.py
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 30 --retry-connrefused --retry-delay 1 --retry-max-time 35 --connect-timeout 1 --max-time 35 http://127.0.0.1:19011/health
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=15
LimitNOFILE=256
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/ps38-claude
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
