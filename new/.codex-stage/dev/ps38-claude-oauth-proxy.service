[Unit]
Description=PS38 Claude loopback OAuth BaseURL gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
LimitCORE=0
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
LogsDirectory=ps38-claude
LogsDirectoryMode=0700
WorkingDirectory=/srv/ps38-claude
Environment=PYTHONPATH=/srv/ps38-claude/current/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ANTHROPIC_PROXY_HOST=127.0.0.1
Environment=ANTHROPIC_PROXY_PORT=19012
Environment=ANTHROPIC_PROXY_LOG=/var/log/ps38-claude/oauth-proxy.log
Environment=AI_QUEUE_DB=/var/lib/ps38-claude/ai-queue.db
Environment=AI_QUEUE_MACHINE=ps38-dev
Environment=AI_QUEUE_CLAUDE_OAUTH_TOKEN_FILE=/home/ubuntu/.config/ps38-claude/oauth-token
Environment=AI_QUEUE_CLAUDE_EGRESS_REQUIRED=1
Environment=AI_QUEUE_CLAUDE_REQUIRED_PROVIDER=subscription@ps38-dev
Environment=AI_QUEUE_OAUTH_PROXY_CLIENT_TIMEOUT_SEC=120
Environment=AI_QUEUE_OAUTH_PROXY_UPSTREAM_TIMEOUT_SEC=180
Environment=AI_QUEUE_OAUTH_PROXY_MAX_BODY_BYTES=33554432
Environment=AI_QUEUE_OAUTH_PROXY_MAX_CONNECTIONS=32
Environment=AI_QUEUE_OAUTH_PROXY_MAX_INFLIGHT_BODY_BYTES=134217728
Environment=AI_QUEUE_OAUTH_PROXY_LOG_MAX_BYTES=5242880
Environment=AI_QUEUE_OAUTH_PROXY_LOG_BACKUPS=5
ExecStartPre=/usr/bin/test -r /var/lib/ps38-claude/ai-queue.db
ExecStartPre=/usr/bin/test -r /home/ubuntu/.config/ps38-claude/oauth-token
ExecStart=/srv/ps38-claude/current/venv/bin/python /srv/ps38-claude/current/bin/ai-queue-oauth-proxy
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 25 --retry-connrefused --retry-delay 1 --retry-max-time 25 --connect-timeout 1 --max-time 25 --header "X-AI-Provider: subscription@ps38-dev" --header "anthropic-api-key: oauth-proxy" http://127.0.0.1:19012/
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
LimitNOFILE=256
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=read-only
ProcSubset=pid
RemoveIPC=true
ReadOnlyPaths=/var/lib/ps38-claude /home/ubuntu/.config/ps38-claude/oauth-token
ReadWritePaths=/var/log/ps38-claude
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
