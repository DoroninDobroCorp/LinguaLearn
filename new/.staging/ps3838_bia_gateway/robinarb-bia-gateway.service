[Unit]
Description=RobinArb BIA-only quote and placement gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=bet-projects
WorkingDirectory=/srv/robinarb-bia-gateway
EnvironmentFile=/etc/robinarb/robinarb-bia-gateway.env

# Compile-time code policy is BIA-only; these overrides are a second runtime
# boundary and ensure legacy credentials cannot revive the removed transport.
Environment=BIA_ONLY_MODE=1
Environment=PS3838_LOGIN_ID=disabled
Environment=PS3838_LOGIN_PASSWORD=disabled
Environment=PS3838_PASSWORD=disabled
Environment=PINNACLE_LINE_WORKER_ENABLED=0
Environment=PS3838_MORE_BET_ENABLED=0
Environment=PS3838_ACCOUNT_RATE_ID=robinarb-bia-gateway

ExecStart=/srv/robinarb-bia-gateway/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8770 --log-level info
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
