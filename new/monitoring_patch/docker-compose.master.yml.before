# ⚠️  ПОСЛЕ ИЗМЕНЕНИЙ GO-КОДА: docker compose build <service> ПЕРЕД up -d!
# См. OPERATIONS.md для полной документации
# МАСТЕР DOCKER-COMPOSE ДЛЯ ЗАПУСКА ВСЕЙ СИСТЕМЫ
# Версия: 2.0 с механизмами самовосстановления и защитой от OOM
# Создан: 2025-10-25

services:
  # ============================================
  # БАЗА ДАННЫХ И КЭШИРОВАНИЕ
  # ============================================
  postgres:
    image: postgres:16.6
    container_name: postgres_livebets
    restart: always
    shm_size: 1GB
    healthcheck:
      test: [
        "CMD-SHELL",
        "psql -U matchingTeams -d matchingTeams -c \"SELECT l.sport_name FROM analyzer.leagues l GROUP BY l.sport_name LIMIT 1;\" | grep -q '[a-zA-Z]'"
      ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
    sysctls:
      kernel.shmall: 1073741824
      kernel.shmmax: 68719476736
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 6G  # Снижено с 8G для экономии памяти
        reservations:
          cpus: '2'
          memory: 4G
    environment:
      POSTGRES_USER: matchingTeams
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: matchingTeams
      PG_OOM_ADJUST_FILE: /proc/self/oom_score_adj
      PG_OOM_ADJUST_VALUE: "-1000"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - postgres-backups:/backups
    ports:
      - "127.0.0.1:5432:5432"
    networks:
      - livebets

  redis:
    container_name: redis_livebets
    image: "redis:7.4.1"
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD}
    networks:
      - livebets

  # ============================================
  # АНАЛИЗАТОРЫ
  # ============================================
  analyzer:
    container_name: analyzer
    entrypoint: /analyzer
    build:
      context: ./backend
      dockerfile: ./analyzer/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "127.0.0.1:7100:7100"  # Вход: данные от Volcano, lobbet, unibet и др.
      - "127.0.0.1:7200:7200"  # Вход: нормализованный поток live-источника через SSH transport
      - "127.0.0.1:7300:7300"  # WS выход: пары с ROI фильтром (для ботов)
      - "127.0.0.1:7005:7005"  # HTTP API: /pairs (ВСЕ пары без фильтра!), /health
      - "127.0.0.1:7304:7304"  # WS выход: full data без ROI фильтра
    env_file:
      - ./backend/analyzer/.env
    environment:
      - PORT_SENDER=7300
      - PORT_SENDER_FULL=7304
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
      - DEBUG_TRACE_TEAM=
      - TG_ALERT_TOKEN=${TG_ALERT_TOKEN:?TG_ALERT_TOKEN is required}
      - TG_ALERT_CHAT_ID=${TG_ALERT_CHAT_ID:?TG_ALERT_CHAT_ID is required}
    volumes:
      - /srv/big_value/logs/bets/captures:/logs/bets/captures
      - /srv/big_value/logs/bets/groups:/logs/bets/groups
      - /srv/big_value/logs/bets/captures_special:/logs/bets/captures_special
      - /srv/big_value/logs/droid_tasks:/logs/droid_tasks
      - /srv/big_value/logs/raw_data:/logs/raw_data
      - /home/ubuntu/.local/bin/droid:/home/ubuntu/.local/bin/droid:ro
      - /srv/big_value/backend:/srv/big_value/backend:ro
      - /home/ubuntu/.factory:/home/ubuntu/.factory:ro
      - /srv/big_value/logs/roi:/logs/roi
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 512M
    healthcheck:
      test: ["CMD-SHELL", "pgrep analyzer || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  analyzer_prematch:
    container_name: analyzer_prematch
    entrypoint: /analyzer
    build:
      context: ./backend
      dockerfile: ./analyzer/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "127.0.0.1:7101:7101"  # Вход: данные от Volcano prematch
      - "127.0.0.1:7201:7201"  # Вход: нормализованный поток prematch-источника через SSH transport
      - "127.0.0.1:7301:7301"  # WS выход: prematch пары с ROI фильтром
      - "127.0.0.1:7006:7006"  # HTTP API: /pairs (ВСЕ prematch пары!), /health
    env_file:
      - ./backend/analyzer/.env.prematch
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
      - DEBUG_TRACE_TEAM=
      - TG_ALERT_TOKEN=${TG_ALERT_TOKEN:?TG_ALERT_TOKEN is required}
      - TG_ALERT_CHAT_ID=${TG_ALERT_CHAT_ID:?TG_ALERT_CHAT_ID is required}
      - GOGC=50         # GC срабатывает при росте хипа на 50% вместо 100%
      - GOMEMLIMIT=7516192768  # 7 GiB: Go агрессивно возвращает память при приближении к лимиту
      - GOMAXPROCS=4    # Ограничиваем Go-планировщик до 4 ядер: снижает lock contention при 12 воркерах
    volumes:
      - /srv/big_value/logs/raw_data:/logs/raw_data
      - /srv/big_value/logs/bets/captures:/logs/bets/captures
      - /srv/big_value/logs/bets/groups:/logs/bets/groups
      - /srv/big_value/logs/bets/captures_special:/logs/bets/captures_special
      - ./backend/analyzer/configs/common.prematch.yml:/configs/common.yml:ro
      - /srv/big_value/logs/roi:/logs/roi
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 9G    # Увеличено с 4G: даём реальный потолок (RAM свободно ~10 ГБ)
        reservations:
          memory: 512M
    healthcheck:
      test: ["CMD-SHELL", "pgrep analyzer || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # ============================================
  # КАЛЬКУЛЯТОР
  # ============================================
  calculator:
    container_name: calculator
    entrypoint: /calculator
    build:
      context: ./backend
      dockerfile: ./calculator/Dockerfile
    restart: always
    depends_on:
      analyzer:
        condition: service_healthy
    env_file:
      - ./backend/calculator/.env
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
    ports:
      - "127.0.0.1:7010:7010"
    volumes:
      - /srv/big_value/logs:/logs
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "pgrep calculator || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # ============================================
  # ПАРСЕРЫ
  # ============================================


  # DISABLED: parse_lobbet
