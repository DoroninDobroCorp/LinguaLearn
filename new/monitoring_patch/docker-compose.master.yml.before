  parse_volcano:
    container_name: parse_volcano
    build:
      context: ./backend/parsers/parse_volcano
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      - analyzer
    ports:
      - "127.0.0.1:9010:9010"
    env_file:
      - ./backend/parsers/parse_volcano/.env
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9010/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # DISABLED: parse_zlatnik_prematch
  # parse_zlatnik_prematch:
  #   container_name: parse_zlatnik_prematch
  #   build:
  #     context: ./backend/parsers/parse_zlatnik
  #     dockerfile: ./Dockerfile
  #   restart: always
  #   depends_on:
  #     - analyzer_prematch
  #   ports:
  #     - "9018:9018"
  #   env_file:
