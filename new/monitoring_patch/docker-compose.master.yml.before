  #     retries: 3
  #     start_period: 40s
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 512M
  #       reservations:
  #         memory: 256M

  parse_volcano_prematch:
    container_name: parse_volcano_prematch
    build:
      context: ./backend/parsers/parse_volcano
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      - analyzer_prematch
    ports:
      - "127.0.0.1:9020:9020"
    env_file:
      - ./backend/parsers/parse_volcano/.env.prematch
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9020/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # GGBet parser (live)
  parse_ggbet:
    container_name: parse_ggbet
    build:
      context: ./backend/parsers/parse_ggbet
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      - analyzer
    ports:
      - "127.0.0.1:9030:9030"
    env_file:
      - ./backend/parsers/parse_ggbet/.env
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9030/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M

  # GGBet parser (prematch)
  parse_ggbet_prematch:
    container_name: parse_ggbet_prematch
    build:
      context: ./backend/parsers/parse_ggbet
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      - analyzer_prematch
    ports:
      - "127.0.0.1:9031:9031"
    env_file:
      - ./backend/parsers/parse_ggbet/.env.prematch
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9031/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M

  # VBet parser (live)
  parse_vbet:
    container_name: parse_vbet
    build:
      context: ./backend
      dockerfile: ./parsers/parse_vbet/Dockerfile
    restart: always
    depends_on:
      - analyzer
    ports:
      - "127.0.0.1:9040:9040"
    environment:
      - SOURCE_NAME=VBet
      - PORT=9040
      - PARSE_LIVE=TRUE
      - PARSE_PREMATCH=FALSE
      - FETCH_INTERVAL=5
      - EVENT_LIST_LIMIT=250
      - DETAIL_CONCURRENCY=8
      - CATALOG_SPORTS=soccer,basketball,tennis,volleyball,handball,hockey
      - VBET_LANGUAGE=${VBET_LANGUAGE:-eng}
      - SENDER_URL=ws://analyzer:7100?api_key=vbet_secret_key_change_in_production
      - VBET_UA_PROXY=${VBET_UA_PROXY:-}
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:9040/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # VBet parser (prematch)
  parse_vbet_prematch:
    container_name: parse_vbet_prematch
    build:
      context: ./backend
      dockerfile: ./parsers/parse_vbet/Dockerfile
    restart: always
    depends_on:
      - analyzer_prematch
    ports:
      - "127.0.0.1:9041:9041"
    environment:
      - SOURCE_NAME=VBet
      - PORT=9041
      - PARSE_LIVE=FALSE
      - PARSE_PREMATCH=TRUE
      - FETCH_INTERVAL=30
      - EVENT_LIST_LIMIT=500
      - DETAIL_CONCURRENCY=8
      - CATALOG_SPORTS=soccer,basketball,tennis,volleyball,handball,hockey
      - VBET_LANGUAGE=${VBET_LANGUAGE:-eng}
      - SENDER_URL=ws://analyzer_prematch:7101?api_key=vbet_secret_key_change_in_production
      - VBET_UA_PROXY=${VBET_UA_PROXY:-}
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:9041/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # Betfair parser (live)
  parse_betfair:
    container_name: parse_betfair
    build:
      context: ./backend
      dockerfile: ./parsers/parse_betfair/Dockerfile
    restart: always
    depends_on:
      - analyzer
    ports:
      - "127.0.0.1:9042:9042"
    environment:
      - SOURCE_NAME=Betfair
      - PORT=9042
      - PARSE_LIVE=TRUE
      - PARSE_PREMATCH=FALSE
      - FETCH_INTERVAL=10
      - EVENT_LIST_LIMIT=250
      - DETAIL_CONCURRENCY=6
      - CATALOG_SPORTS=soccer,basketball,tennis,volleyball,handball,hockey
      - SENDER_URL=ws://analyzer:7100?api_key=betfair_secret_key_change_in_production
      - BETFAIR_USERNAME=${BETFAIR_USERNAME:-}
      - BETFAIR_PASSWORD=${BETFAIR_PASSWORD:-}
      - BETFAIR_APP_KEY=${BETFAIR_APP_KEY:-}
      - BETFAIR_SESSION_TOKEN=${BETFAIR_SESSION_TOKEN:-}
      - BETFAIR_PROXY=${BETFAIR_PROXY:-}
      - BETFAIR_PROXY_PROTOCOL=${BETFAIR_PROXY_PROTOCOL:-socks5}
      - BETFAIR_AUTO_DISCOVER_APP_KEY=${BETFAIR_AUTO_DISCOVER_APP_KEY:-1}
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:9042/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # Betfair parser (prematch)
  parse_betfair_prematch:
    container_name: parse_betfair_prematch
    build:
      context: ./backend
      dockerfile: ./parsers/parse_betfair/Dockerfile
    restart: always
    depends_on:
      - analyzer_prematch
    ports:
      - "127.0.0.1:9043:9043"
    environment:
      - SOURCE_NAME=Betfair
      - PORT=9043
      - PARSE_LIVE=FALSE
      - PARSE_PREMATCH=TRUE
      - FETCH_INTERVAL=30
      - EVENT_LIST_LIMIT=500
      - DETAIL_CONCURRENCY=6
      - CATALOG_SPORTS=soccer,basketball,tennis,volleyball,handball,hockey
      - SENDER_URL=ws://analyzer_prematch:7101?api_key=betfair_secret_key_change_in_production
      - BETFAIR_USERNAME=${BETFAIR_USERNAME:-}
      - BETFAIR_PASSWORD=${BETFAIR_PASSWORD:-}
      - BETFAIR_APP_KEY=${BETFAIR_APP_KEY:-}
      - BETFAIR_SESSION_TOKEN=${BETFAIR_SESSION_TOKEN:-}
      - BETFAIR_PROXY=${BETFAIR_PROXY:-}
      - BETFAIR_PROXY_PROTOCOL=${BETFAIR_PROXY_PROTOCOL:-socks5}
      - BETFAIR_AUTO_DISCOVER_APP_KEY=${BETFAIR_AUTO_DISCOVER_APP_KEY:-1}
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:9043/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M


  # DISABLED: parse_sbbet
  # parse_sbbet:
  #   container_name: parse_sbbet
  #   build:
  #     context: ./backend/parsers/parse_sbbet
  #     dockerfile: ./Dockerfile
  #   restart: always
  #   depends_on:
  #     - analyzer
  #   ports:
  #     - "9012:9012"
  #   env_file:
  #     - ./backend/parsers/parse_sbbet/.env
  #   networks:
  #     - livebets
  #   healthcheck:
  #     test: ["CMD-SHELL", "wget -q --spider http://localhost:9012/health || exit 1"]
  #     interval: 30s
  #     timeout: 10s
  #     retries: 3
  #     start_period: 40s
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 512M
  #       reservations:
  #         memory: 256M

  # DISABLED: parse_sbbet_prematch
  # parse_sbbet_prematch:
  #   container_name: parse_sbbet_prematch
  #   build:
  #     context: ./backend/parsers/parse_sbbet
  #     dockerfile: ./Dockerfile
  #   command: ["python", "main.py"]
  #   restart: always
  #   depends_on:
  #     - analyzer_prematch
  #   ports:
  #     - "9022:9022"
  #   env_file:
  #     - ./backend/parsers/parse_sbbet/.env.prematch
  #   dns:
  #     - 8.8.8.8
  #     - 1.1.1.1
  #   networks:
  #     - livebets
  #   healthcheck:
  #     test: ["CMD-SHELL", "wget -q --spider http://localhost:9022/health || exit 1"]
  #     interval: 30s
  #     timeout: 10s
  #     retries: 3
  #     start_period: 40s
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 512M
  #       reservations:
  #         memory: 256M

  # ============================================
  # TELEGRAM БОТЫ
  # ============================================
  tg_livebot:
    container_name: tg_livebot
    build:
      context: ./backend
      dockerfile: ./telegram/tg_livebot/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - ./backend/telegram/tg_livebot/.env
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
    ports:
      - "127.0.0.1:7040:7040"
    volumes:
      - /srv/big_value/logs:/logs
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  tg_prematch_bot:
    container_name: tg_prematch_bot
    build:
      context: ./backend/telegram/tg_prematch_bot
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      - analyzer_prematch
    env_file:
      - ./backend/telegram/tg_prematch_bot/.env
    ports:
      - "127.0.0.1:7045:7045"
    volumes:
      - tg_prematch_data:/data
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M
  tg_manager:
    container_name: tg_manager
    build:
      context: ./backend
      dockerfile: ./telegram/tg_manager/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    env_file:
      - ./backend/telegram/tg_manager/.env
    environment:
      - POSTGRES_HOST=postgres_livebets
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
    ports:
      - "127.0.0.1:7020:7020"
    volumes:
      - /srv/big_value/logs:/logs
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  # ============================================
  # ДОПОЛНИТЕЛЬНЫЕ СЕРВИСЫ
  # ============================================
  results:
    container_name: results
    entrypoint: /results
    build:
      context: ./backend
      dockerfile: ./results/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - ./backend/results/.env
    ports:
      - "127.0.0.1:7030:7030"
    volumes:
      - /srv/big_value/logs:/logs
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  statistic:
    container_name: statistic
    build:
      context: ./backend/statistic
      dockerfile: ./Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - ./backend/statistic/.env
    environment:
      - POSTGRES_HOST=postgres_livebets
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - HOME=/home/ubuntu
    ports:
      - "127.0.0.1:7021:7020"
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  auto_matcher:
    container_name: auto_matcher
    entrypoint: /auto_matcher
    build:
      context: ./backend
      dockerfile: ./auto_matcher/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - ./backend/auto_matcher/.env
    environment:
      - SERVER_PORT=7001
      - MODE=live
    ports:
      - "127.0.0.1:7050:7001"
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  auto_matcher_prematch:
    container_name: auto_matcher_prematch
    entrypoint: /auto_matcher
    build:
      context: ./backend
      dockerfile: ./auto_matcher/Dockerfile
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
    env_file:
      - ./backend/auto_matcher/.env
    environment:
      - SERVER_PORT=7002
      - MODE=prematch
    ports:
      - "127.0.0.1:7051:7002"
    networks:
      - livebets
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # ============================================
  # МОНИТОРИНГ
  # ============================================
  prometheus:
    image: prom/prometheus:v3.3.0
    container_name: prometheus
    restart: always
    user: "65534:65534"
    ports:
      - "127.0.0.1:9090:9090"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - ./monitoring/prometheus/alert_rules.yaml:/etc/prometheus/alert_rules.yaml
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    networks:
      - monitoring
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  alertmanager:
    image: prom/alertmanager:v0.28.1
    container_name: alertmanager
    restart: always
    user: "65534:65534"
    ports:
      - "127.0.0.1:9093:9093"
    volumes:
      - ./monitoring/alertmanager/alertmanager.yaml:/etc/alertmanager/alertmanager.yml
      - alertmanager_data:/alertmanager
    env_file:
      - ./monitoring/.env
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    networks:
      - monitoring
    depends_on:
      - prometheus
    deploy:
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M

  grafana:
    image: grafana/grafana:11.6.1
    container_name: grafana
    restart: always
    user: "472:472"
    ports:
      - "127.0.0.1:24600:3000"
    volumes:
      - grafana_data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_USER: dmitry
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
    depends_on:
      - prometheus
    networks:
      - monitoring
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.52.1
    container_name: cadvisor
    restart: always
    command:
      - --housekeeping_interval=10s
      - --docker_only=true
      - --disable_metrics=percpu,sched,tcp,udp,disk,diskIO,hugetlb,referenced_memory,resctrl,process
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    depends_on:
      - prometheus
    networks:
      - monitoring
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

  postgres_exporter:
    image: prometheuscommunity/postgres-exporter:v0.17.1
    container_name: postgres_exporter
    restart: always
    env_file:
      - ./monitoring/.env
    environment:
      DATA_SOURCE_NAME: "postgresql://matchingTeams:${POSTGRES_PASSWORD}@postgres_livebets:5432/matchingTeams?sslmode=disable"
    networks:
      - monitoring
      - livebets
    depends_on:
      postgres:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M

  # ============================================
  # LOGGING (LOKI + PROMTAIL)
  # ============================================
  loki:
    image: grafana/loki:3.0.0
    container_name: loki
    restart: always
    ports:
      - "127.0.0.1:3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    networks:
      - monitoring
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  promtail:
    image: grafana/promtail:3.0.0
    container_name: promtail
    restart: always
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/promtail:/tmp
      - ./monitoring/promtail/config.yml:/etc/promtail/config.yml
    command: -config.file=/etc/promtail/config.yml
    networks:
      - monitoring
    depends_on:
      - loki
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

volumes:
  postgres_data:
  postgres-backups:
  tg_prematch_data:
  prometheus_data:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/prometheus/data
      o: bind
  grafana_data:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/grafana
      o: bind
  alertmanager_data:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/alertmanager
      o: bind

networks:
  livebets:
    name: livebets
    external: true
  monitoring:
    external: false
