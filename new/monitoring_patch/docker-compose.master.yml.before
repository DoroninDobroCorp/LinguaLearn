  # DISABLED: parse_sansabet
  parse_sansabet:
    container_name: parse_sansabet
    entrypoint: /app
    build:
      context: ./backend
      dockerfile: ./parsers/Dockerfile.parser
      args:
        code_dir: parsers/parse_sansabet
    restart: always
    depends_on:
      - analyzer
    ports:
      - "127.0.0.1:9003:9003"
    env_file:
      - ./backend/parsers/parse_sansabet/.env
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:9003/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

  # DISABLED: parse_sansabet_prematch
  parse_sansabet_prematch:
    container_name: parse_sansabet_prematch
    entrypoint: /app
    build:
      context: ./backend
      dockerfile: ./parsers/Dockerfile.parser
      args:
        code_dir: parsers/parse_sansabet
    restart: always
    depends_on:
      - analyzer_prematch
    ports:
      - "127.0.0.1:9013:9013"
    env_file:
      - ./backend/parsers/parse_sansabet/.env.prematch
    networks:
      - livebets
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:9013/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M

