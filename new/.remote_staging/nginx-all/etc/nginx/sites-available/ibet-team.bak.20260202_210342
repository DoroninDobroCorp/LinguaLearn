# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name ibet.team www.ibet.team;
    
    # Allow Let's Encrypt validation
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    
    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name ibet.team www.ibet.team;
    
    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/ibet.team/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ibet.team/privkey.pem;
    
    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    
    root /var/www/html;
    index index.html;
    
    # Health dashboard files (exact match)
    location = /health-dashboard.html {
        proxy_pass http://localhost:8090/web/dashboard.html;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache, must-revalidate";
    }
    
    location = /health-data.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate";
        add_header Content-Type "application/json";
    }
    
    # NEW: Unified Health Board API (proxied to monitor.py on port 8090)
    location = /health-status.json {
        proxy_pass http://localhost:8090/health-status.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Timeout settings to prevent hanging
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 10s;
        
        add_header Cache-Control "no-cache, must-revalidate";
        add_header Content-Type "application/json";
        add_header Access-Control-Allow-Origin "*";
    }
    
    # Static project sites
    location /our_world/ {
        try_files $uri $uri/index.html =404;
    }
    
    location /your-work/ {
        index index.html;
        try_files $uri $uri/index.html =404;
    }
    
    location /your-mlrd/ {
        index presentation.html;
        try_files $uri $uri/index.html =404;
    }
    
    location /new-era/ {
        index business_proposal.html;
        try_files $uri $uri/index.html =404;
    }
    
    # AI PM Monitor
    location /ai-pm-monitor/ {
        alias /var/www/ai-pm-monitor/;
        index index.html;
        try_files $uri $uri/index.html =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Content-Type "text/html; charset=utf-8" always;
    }
    
    location /ai-pm-monitor/status/ {
        alias /var/www/ai-pm-monitor/status/;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Content-Type "application/json" always;
        add_header Access-Control-Allow-Origin "*" always;
    }
    
    # Detective Board (Vite dev server) - NEW PATH
    location /detective-board/ {
        proxy_pass http://localhost:5173/detective-board/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }
    
    # TEMPORARY: Detective Board OLD PATH for data export
    location /detective-board-old/ {
        proxy_pass http://localhost:5174/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
