# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name admin.ibet.team;
    
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name admin.ibet.team;
    
    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/admin.ibet.team/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.ibet.team/privkey.pem;
    
    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    
    # IP Whitelist (весь admin кроме /pasha/)
    include /etc/nginx/snippets/allowed-ips.conf;
    deny all;
    
    # Pasha Math Journey — публичное, без IP ограничений
    location /pasha/ {
        allow all;
        proxy_pass http://localhost:3002/pasha/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
    
    # Public client - Sports list
    location = /api/auto-matcher/hand-merge/sports {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7050/hand-merge/sports;
    }

    # Public client - Bookmakers list
    location = /api/auto-matcher/hand-merge/bookmakers {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7050/hand-merge/bookmakers;
    }

    # API Proxy - Auto Matcher
    location /api/auto-matcher/ {
        proxy_pass http://localhost:7050/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS headers
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    # Public client - Calculator bet sizing
    location = /api/calculator/calc-bet {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7010/calc-bet;
    }

    # Public client - Calculator limits
    location = /api/calculator/check-betting-limits {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7010/check-betting-limits;
    }


    # API Proxy - Calculator
    location /api/calculator/ {
        proxy_pass http://localhost:7010/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS headers
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    # API Proxy - Live Match Data (Analyzer)
    location /api/live-match-data/ {
        proxy_pass http://localhost:7005/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS headers
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    # API Proxy - Prematch Match Data (Analyzer Prematch)
    location /api/prematch-match-data/ {
        proxy_pass http://localhost:7006/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS headers
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    # Public client - Work time
    location = /api/manager/work_time {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/work_time;
    }

    # Public client - User filters
    location = /api/manager/filters {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/filters;
    }

    # Public client - Bet logging
    location = /api/manager/log_bet {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/log_bet;
    }

    # Public client - Manual bet logging
    location = /api/manager/log_bet_manual {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/log_bet_manual;
    }

    # API Proxy - Manager
    location /api/manager/ {
        proxy_pass http://localhost:7020/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Public client - Runner grouped status
    location = /api/runner/status/grouped {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:9200/status/grouped;
    }

    # API Proxy - Runner
    location /api/runner/ {
        proxy_pass http://localhost:9200/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS headers
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-API-Key,x-trace-id" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    # WebSocket Proxy - Analyzer Full (no ROI filter)
    location /api/analyzer/live-full {
        proxy_pass http://localhost:7304/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket Proxy - Analyzer Live
    location /api/analyzer/live {
        allow all;
        proxy_pass http://localhost:7300/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket timeouts
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    
    # WebSocket Proxy - Analyzer Prematch
    location /api/analyzer/prematch {
        allow all;
        proxy_pass http://localhost:7301/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket timeouts
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    
    # Next.js AdminCli Frontend (port 31562)
    # Match Data API (direct to analyzer)
    location = /api/match-data {
        
        
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        
        proxy_pass http://127.0.0.1:31562/api/match-data;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/match-data-prematch {
        
        
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        
        proxy_pass http://127.0.0.1:31562/api/match-data-prematch;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Raw Data Proxy for Parser Inspector
    # Raw Data Proxy for Parser Inspector
    location /api/raw-data {
        proxy_pass http://127.0.0.1:9500;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 15s;
        add_header Access-Control-Allow-Origin "https://admin.ibet.team" always;
        if ($request_method = 'OPTIONS') { return 204; }
    }


    location / {
        proxy_pass http://localhost:31562;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }


    # Multi-Bookmaker Parser Monitor
    location /parser-monitor {
        alias /var/www/html/parser-monitor.html;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        if_modified_since off;
        expires off;
        etag off;
    }

    # Pasha moved above (with allow all)

}

