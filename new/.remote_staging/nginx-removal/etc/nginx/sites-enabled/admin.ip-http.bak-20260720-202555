server {
    listen 80;
    server_name 145.239.82.124;

    allow 127.0.0.1;
    allow ::1;
    include /etc/nginx/snippets/allowed-ips.conf;
    deny all;

    location = /api/auto-matcher/hand-merge/sports {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7050/hand-merge/sports;
    }

    location = /api/auto-matcher/hand-merge/bookmakers {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7050/hand-merge/bookmakers;
    }

    location /api/auto-matcher/ {
        proxy_pass http://localhost:7050/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location = /api/calculator/calc-bet {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7010/calc-bet;
    }

    location = /api/calculator/check-betting-limits {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7010/check-betting-limits;
    }

    location /api/calculator/ {
        proxy_pass http://localhost:7010/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location /api/live-match-data/ {
        proxy_pass http://localhost:7005/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location /api/prematch-match-data/ {
        proxy_pass http://localhost:7006/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location = /api/manager/work_time {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/work_time;
    }

    location = /api/manager/filters {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/filters;
    }

    location = /api/manager/log_bet {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/log_bet;
    }

    location = /api/manager/log_bet_manual {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:7020/log_bet_manual;
    }

    location /api/manager/ {
        proxy_pass http://localhost:7020/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/runner/status/grouped {
        include /etc/nginx/snippets/public-client-api.conf;
        proxy_pass http://localhost:9200/status/grouped;
    }

    location /api/runner/ {
        proxy_pass http://localhost:9200/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    location /api/analyzer/live-full {
        allow all;
        proxy_pass http://localhost:7304/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/analyzer/live {
        allow all;
        proxy_pass http://localhost:7300/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/analyzer/prematch {
        allow all;
        proxy_pass http://localhost:7301/output;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/match-data {
        allow all;
        proxy_pass http://127.0.0.1:31562/api/match-data;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/match-data-prematch {
        allow all;
        proxy_pass http://127.0.0.1:31562/api/match-data-prematch;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/raw-data {
        proxy_pass http://127.0.0.1:9500;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 15s;

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    # English Learning Assistant API
    location /english/api/ {
        allow all;
        proxy_pass http://localhost:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # English Learning Assistant static files
    location = /english {
        allow all;
        return 301 /english/;
    }

    location /english/ {
        allow all;
        alias /srv/LinguaLearn/english/dist/;
        index index.html;
        try_files $uri $uri/ /english/index.html;
    }

    # Spanish Learning Assistant API
    location /spanish/api/ {
        allow all;
        proxy_pass http://localhost:3003/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Spanish Learning Assistant static files
    location = /spanish {
        allow all;
        return 301 /spanish/;
    }

    location = /spanish/ {
        allow all;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        return 302 /spanish/vocabulary;
    }

    location /spanish/ {
        allow all;
        alias /srv/LinguaLearn/spanish/dist/;
        index index.html;
        try_files $uri /spanish/index.html;
    }

    # Public access for Bugalter report pages via plain IP
    location ~ ^/(|login|health|bookmakers|matches|reports|api/search_matches|bookmaker/.*|match/.*|report/.*)$ {
        allow all;
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://localhost:31562;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
