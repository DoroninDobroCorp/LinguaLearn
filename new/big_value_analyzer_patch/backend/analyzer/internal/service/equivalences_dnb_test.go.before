package service

import (
	"testing"

	"livebets/analazer/internal/entity"
)

// TestDNBCanonicalAtZeroScore verifies DNB maps to H0 at score 0:0.
func TestDNBCanonicalAtZeroScore(t *testing.T) {
	period := entity.PeriodData{
		DrawNoBet: &entity.DrawNoBetStruct{
			Home: entity.Odd{Value: 1.85},
			Away: entity.Odd{Value: 2.05},
		},
		Handicap: map[string]*entity.WinHandicap{},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Soccer")
	if c, ok := canon["H1 0"]; !ok {
		t.Fatal("expected H1 0 from DNB at score 0:0")
	} else if c.Odd.Value != 1.85 {
		t.Fatalf("expected H1 0 value=1.85, got %v", c.Odd.Value)
	}
	if c, ok := canon["H2 0"]; !ok {
		t.Fatal("expected H2 0 from DNB at score 0:0")
	} else if c.Odd.Value != 2.05 {
		t.Fatalf("expected H2 0 value=2.05, got %v", c.Odd.Value)
	}
}

// TestDNBCanonicalAtNonZeroScore verifies DNB maps to H0 even at non-zero score.
func TestDNBCanonicalAtNonZeroScore(t *testing.T) {
	period := entity.PeriodData{
		DrawNoBet: &entity.DrawNoBetStruct{
			Home: entity.Odd{Value: 1.60},
			Away: entity.Odd{Value: 2.40},
		},
		Handicap: map[string]*entity.WinHandicap{},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 2, 1, "Soccer")
	if _, ok := canon["H1 0"]; !ok {
		t.Fatal("expected H1 0 from DNB at score 2:1 — DNB=H0 is absolute identity")
	}
	if _, ok := canon["H2 0"]; !ok {
		t.Fatal("expected H2 0 from DNB at score 2:1 — DNB=H0 is absolute identity")
	}
}

// TestDNBUpdateIfBetter verifies that the higher price wins when both Handicap["0"] and DNB exist.
func TestDNBUpdateIfBetter(t *testing.T) {
	period := entity.PeriodData{
		Handicap: map[string]*entity.WinHandicap{
			"0": {Win1: entity.Odd{Value: 1.80}, Win2: entity.Odd{Value: 2.00}},
		},
		DrawNoBet: &entity.DrawNoBetStruct{
			Home: entity.Odd{Value: 1.90}, // Higher than Handicap
			Away: entity.Odd{Value: 1.95}, // Lower than Handicap
		},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Soccer")

	// DNB Home 1.90 > Handicap 1.80 → DNB wins
	if c := canon["H1 0"]; c.Odd.Value != 1.90 {
		t.Fatalf("expected H1 0 value=1.90 (DNB higher), got %v", c.Odd.Value)
	}
	// DNB Away 1.95 < Handicap 2.00 → Handicap wins
	if c := canon["H2 0"]; c.Odd.Value != 2.00 {
		t.Fatalf("expected H2 0 value=2.00 (Handicap higher), got %v", c.Odd.Value)
	}
}

// TestWin1x2AtNonZeroScore verifies Win1x2 maps to H±0.5 even at non-zero score.
func TestWin1x2AtNonZeroScore(t *testing.T) {
	period := entity.PeriodData{
		Win1x2: entity.Win1x2Struct{
			Win1:    entity.Odd{Value: 2.10},
			WinNone: entity.Odd{Value: 3.50},
			Win2:    entity.Odd{Value: 3.20},
		},
	}

	// Pinnacle side
	canon := canonicalizePinnacleMarkets(period, 0, 2, 1, "Soccer")
	if _, ok := canon["H1 -0.5"]; !ok {
		t.Fatal("expected H1 -0.5 from Win1 at score 2:1")
	}
	if _, ok := canon["H2 -0.5"]; !ok {
		t.Fatal("expected H2 -0.5 from Win2 at score 2:1")
	}

	// Donor side
	markets := extractAllDonorMarkets(period, 0, 2, 1, "Soccer")
	for _, m := range markets {
		if m.OriginalKey == "1" && m.CanonicalKey != "H1 -0.5" {
			t.Fatalf("donor Win1 at non-zero score: expected canonical H1 -0.5, got %s", m.CanonicalKey)
		}
		if m.OriginalKey == "2" && m.CanonicalKey != "H2 -0.5" {
			t.Fatalf("donor Win2 at non-zero score: expected canonical H2 -0.5, got %s", m.CanonicalKey)
		}
	}
}

// TestHTSCanonicalToIT verifies HTS/ATS map to IT1/IT2 0.5 canonical keys.
func TestHTSCanonicalToIT(t *testing.T) {
	period := entity.PeriodData{
		HomeTeamToScore: &entity.YesNo{
			Yes: entity.Odd{Value: 1.30},
			No:  entity.Odd{Value: 3.50},
		},
		AwayTeamToScore: &entity.YesNo{
			Yes: entity.Odd{Value: 1.45},
			No:  entity.Odd{Value: 2.80},
		},
	}

	// Pinnacle side
	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Soccer")
	if c, ok := canon["IT1> 0.5"]; !ok {
		t.Fatal("expected IT1> 0.5 from HTS Yes")
	} else if c.Odd.Value != 1.30 {
		t.Fatalf("expected IT1> 0.5 value=1.30, got %v", c.Odd.Value)
	}
	if c, ok := canon["IT1< 0.5"]; !ok {
		t.Fatal("expected IT1< 0.5 from HTS No")
	} else if c.Odd.Value != 3.50 {
		t.Fatalf("expected IT1< 0.5 value=3.50, got %v", c.Odd.Value)
	}
	if _, ok := canon["IT2> 0.5"]; !ok {
		t.Fatal("expected IT2> 0.5 from ATS Yes")
	}
	if _, ok := canon["IT2< 0.5"]; !ok {
		t.Fatal("expected IT2< 0.5 from ATS No")
	}

	// Donor side
	markets := extractAllDonorMarkets(period, 0, 0, 0, "Soccer")
	for _, m := range markets {
		switch m.OriginalKey {
		case "HTS Yes":
			if m.CanonicalKey != "IT1> 0.5" {
				t.Fatalf("donor HTS Yes: expected IT1> 0.5, got %s", m.CanonicalKey)
			}
		case "HTS No":
			if m.CanonicalKey != "IT1< 0.5" {
				t.Fatalf("donor HTS No: expected IT1< 0.5, got %s", m.CanonicalKey)
			}
		case "ATS Yes":
			if m.CanonicalKey != "IT2> 0.5" {
				t.Fatalf("donor ATS Yes: expected IT2> 0.5, got %s", m.CanonicalKey)
			}
		case "ATS No":
			if m.CanonicalKey != "IT2< 0.5" {
				t.Fatalf("donor ATS No: expected IT2< 0.5, got %s", m.CanonicalKey)
			}
		}
	}
}

// TestHTSUpdateIfBetterWithIT verifies HTS competes with FirstTeamTotals via updateIfBetter.
func TestHTSUpdateIfBetterWithIT(t *testing.T) {
	period := entity.PeriodData{
		HomeTeamToScore: &entity.YesNo{
			Yes: entity.Odd{Value: 1.35}, // Higher than IT1> 0.5
		},
		FirstTeamTotals: map[string]*entity.WinLessMore{
			"0.5": {WinMore: entity.Odd{Value: 1.28}, WinLess: entity.Odd{Value: 3.60}},
		},
		SecondTeamTotals: map[string]*entity.WinLessMore{
			"0.5": {WinMore: entity.Odd{Value: 1.40}, WinLess: entity.Odd{Value: 2.90}},
		},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Soccer")
	// HTS Yes 1.35 > IT1> 0.5 from FirstTeamTotals 1.28 → HTS wins
	if c := canon["IT1> 0.5"]; c.Odd.Value != 1.35 {
		t.Fatalf("expected IT1> 0.5 value=1.35 (HTS higher), got %v", c.Odd.Value)
	}
	// IT1< 0.5 should come from FirstTeamTotals (HTS No not set)
	if c, ok := canon["IT1< 0.5"]; !ok {
		t.Fatal("expected IT1< 0.5 from FirstTeamTotals")
	} else if c.Odd.Value != 3.60 {
		t.Fatalf("expected IT1< 0.5 value=3.60, got %v", c.Odd.Value)
	}
}

// Test3WHToAHPinnacle verifies 3WH Home/Away map to AH canonical keys.
func Test3WHToAHPinnacle(t *testing.T) {
	period := entity.PeriodData{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-1": {
				Home: entity.Odd{Value: 2.50}, // 3WH -1 Home → H1 -1.5
				Draw: entity.Odd{Value: 3.00},
				Away: entity.Odd{Value: 2.80}, // 3WH -1 Away → H2 0.5
			},
			"+1": {
				Home: entity.Odd{Value: 1.40}, // 3WH +1 Home → H1 0.5
				Draw: entity.Odd{Value: 4.50},
				Away: entity.Odd{Value: 7.00}, // 3WH +1 Away → H2 -1.5
			},
			"0": {
				Home: entity.Odd{Value: 1.90}, // 3WH 0 Home → H1 -0.5
				Draw: entity.Odd{Value: 3.40},
				Away: entity.Odd{Value: 4.00}, // 3WH 0 Away → H2 -0.5
			},
		},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Soccer")

	// Native 3WH keys must stay available for exact matching.
	exactTests := []struct {
		key   string
		value float64
	}{
		{"3WH -1 1", 2.50},
		{"3WH -1 2", 2.80},
		{"3WH +1 1", 1.40},
		{"3WH +1 2", 7.00},
		{"3WH +0 1", 1.90},
		{"3WH +0 2", 4.00},
	}
	for _, tt := range exactTests {
		c, ok := canon[tt.key]
		if !ok {
			t.Fatalf("expected exact %s from 3WH canonicalization", tt.key)
		}
		if c.Odd.Value != tt.value {
			t.Fatalf("expected exact %s value=%v, got %v", tt.key, tt.value, c.Odd.Value)
		}
	}

	tests := []struct {
		key   string
		value float64
	}{
		{"H1 -1.5", 2.50},
		{"H2 0.5", 2.80},
		{"H1 0.5", 1.40},
		{"H2 -1.5", 7.00},
		{"H1 -0.5", 1.90},
		{"H2 -0.5", 4.00},
	}

	for _, tt := range tests {
		c, ok := canon[tt.key]
		if !ok {
			t.Fatalf("expected %s from 3WH mapping", tt.key)
		}
		if c.Odd.Value != tt.value {
			t.Fatalf("expected %s value=%v, got %v", tt.key, tt.value, c.Odd.Value)
		}
	}

	// Draw should stay as 3WH key
	if _, ok := canon["3WH -1 X"]; !ok {
		t.Fatal("expected 3WH -1 X (Draw has no AH equivalent)")
	}
}

// Test3WHToAHDonor verifies donor 3WH keeps exact canonical key and stores AH as fallback.
func Test3WHToAHDonor(t *testing.T) {
	period := entity.PeriodData{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-2": {
				Home: entity.Odd{Value: 3.00}, // → H1 -2.5
				Away: entity.Odd{Value: 2.10}, // → H2 1.5
				Draw: entity.Odd{Value: 3.50},
			},
		},
	}

	markets := extractAllDonorMarkets(period, 0, 0, 0, "Soccer")
	found := map[string]DonorMarketWithCanonical{}
	for _, m := range markets {
		found[m.OriginalKey] = m
	}

	if market, ok := found["3WH -2 1"]; !ok {
		t.Fatal("3WH -2 1 not found in donor markets")
	} else {
		if market.CanonicalKey != "3WH -2 1" {
			t.Fatalf("3WH -2 Home: expected exact canonical 3WH -2 1, got %s", market.CanonicalKey)
		}
		if market.FallbackCanonicalKey != "H1 -2.5" {
			t.Fatalf("3WH -2 Home: expected fallback H1 -2.5, got %s", market.FallbackCanonicalKey)
		}
		if !market.RequireStdPinnacleOdds {
			t.Fatal("3WH -2 Home: expected RequireStdPinnacleOdds=true")
		}
		if market.PreferredPinnacleKey != "H1 -2.5" {
			t.Fatalf("3WH -2 Home: expected preferred Pinnacle key H1 -2.5, got %s", market.PreferredPinnacleKey)
		}
	}
	if market, ok := found["3WH -2 2"]; !ok {
		t.Fatal("3WH -2 2 not found in donor markets")
	} else {
		if market.CanonicalKey != "3WH -2 2" {
			t.Fatalf("3WH -2 Away: expected exact canonical 3WH -2 2, got %s", market.CanonicalKey)
		}
		if market.FallbackCanonicalKey != "H2 1.5" {
			t.Fatalf("3WH -2 Away: expected fallback H2 1.5, got %s", market.FallbackCanonicalKey)
		}
		if !market.RequireStdPinnacleOdds {
			t.Fatal("3WH -2 Away: expected RequireStdPinnacleOdds=true")
		}
		if market.PreferredPinnacleKey != "H2 1.5" {
			t.Fatalf("3WH -2 Away: expected preferred Pinnacle key H2 1.5, got %s", market.PreferredPinnacleKey)
		}
	}
	if market, ok := found["3WH -2 X"]; !ok || market.CanonicalKey != "3WH -2 X" {
		t.Fatalf("3WH -2 Draw: expected 3WH -2 X (no equiv), got %+v (found=%v)", market, ok)
	}
}

func TestFindCommonOutcomes3WHPrefersExactNativePinnacle(t *testing.T) {
	donor := []entity.PeriodData{{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-1": {Home: entity.Odd{Value: 4.65}},
		},
	}}
	pinnacle := []entity.PeriodData{{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-1": {Home: entity.Odd{Value: 5.10}},
		},
		Handicap: map[string]*entity.WinHandicap{
			"-1.5": {Win1: entity.Odd{Value: 3.82}, Win2: entity.Odd{Value: 1.25}},
		},
	}}

	common, _ := findCommonOutcomesV2(donor, pinnacle, 0, 0, "Soccer")
	got, ok := common["3WH -1 1"]
	if !ok {
		t.Fatal("expected 3WH -1 1 in common outcomes")
	}
	if got.CanonicalKey != "3WH -1 1" {
		t.Fatalf("expected exact canonical key 3WH -1 1, got %s", got.CanonicalKey)
	}
	if got.PinnacleBestSource != "3WH -1 1" {
		t.Fatalf("expected exact Pinnacle source 3WH -1 1, got %s", got.PinnacleBestSource)
	}
	if got.PinnacleStdOdds != 5.10 {
		t.Fatalf("expected PinnacleStdOdds=5.10, got %v", got.PinnacleStdOdds)
	}
	if got.Odds[1].Value != 5.10 {
		t.Fatalf("expected Pinnacle odds=5.10, got %v", got.Odds[1].Value)
	}
}

func TestFindCommonOutcomes3WHFallsBackToStrictStandardAH(t *testing.T) {
	donor := []entity.PeriodData{{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-1": {Home: entity.Odd{Value: 4.65}},
		},
	}}
	pinnacle := []entity.PeriodData{{
		WinningMargin: map[string]*entity.Odd{
			"Home By 2+": {Value: 4.20},
		},
		Handicap: map[string]*entity.WinHandicap{
			"-1.5": {Win1: entity.Odd{Value: 3.82}, Win2: entity.Odd{Value: 1.25}},
		},
	}}

	common, _ := findCommonOutcomesV2(donor, pinnacle, 0, 0, "Soccer")
	got, ok := common["3WH -1 1"]
	if !ok {
		t.Fatal("expected 3WH -1 1 in common outcomes via fallback")
	}
	if got.CanonicalKey != "H1 -1.5" {
		t.Fatalf("expected fallback canonical key H1 -1.5, got %s", got.CanonicalKey)
	}
	if got.PinnacleBestSource != "H1 -1.5" {
		t.Fatalf("expected strict Pinnacle source H1 -1.5, got %s", got.PinnacleBestSource)
	}
	if got.PinnacleStdOdds != 3.82 {
		t.Fatalf("expected PinnacleStdOdds=3.82, got %v", got.PinnacleStdOdds)
	}
	if got.Odds[1].Value != 3.82 {
		t.Fatalf("expected strict fallback Pinnacle odds=3.82, got %v", got.Odds[1].Value)
	}
}

func TestFindCommonOutcomes3WHSkipsSyntheticFallbackWithoutStdLine(t *testing.T) {
	donor := []entity.PeriodData{{
		ThreeWayHandicap: map[string]*entity.ThreeWayHcap{
			"-1": {Home: entity.Odd{Value: 4.65}},
		},
	}}
	pinnacle := []entity.PeriodData{{
		WinningMargin: map[string]*entity.Odd{
			"Home By 2+": {Value: 4.20},
		},
	}}

	common, _ := findCommonOutcomesV2(donor, pinnacle, 0, 0, "Soccer")
	if _, ok := common["3WH -1 1"]; ok {
		t.Fatal("did not expect 3WH -1 1 when only synthetic fallback exists without standard AH line")
	}
}

// TestDNBDonorCanonicalAtNonZeroScore verifies donor DNB always uses H0 canonical key.
func TestDNBDonorCanonicalAtNonZeroScore(t *testing.T) {
	period := entity.PeriodData{
		DrawNoBet: &entity.DrawNoBetStruct{
			Home: entity.Odd{Value: 1.75},
			Away: entity.Odd{Value: 2.15},
		},
	}

	markets := extractAllDonorMarkets(period, 0, 3, 1, "Soccer")
	foundH1, foundH2 := false, false
	for _, m := range markets {
		if m.OriginalKey == "DNB 1" {
			if m.CanonicalKey != "H1 0" {
				t.Fatalf("expected canonical H1 0, got %s", m.CanonicalKey)
			}
			foundH1 = true
		}
		if m.OriginalKey == "DNB 2" {
			if m.CanonicalKey != "H2 0" {
				t.Fatalf("expected canonical H2 0, got %s", m.CanonicalKey)
			}
			foundH2 = true
		}
	}
	if !foundH1 {
		t.Fatal("DNB 1 not found in donor markets at non-zero score")
	}
	if !foundH2 {
		t.Fatal("DNB 2 not found in donor markets at non-zero score")
	}
}

// TestTwoWayWin1x2Hockey verifies Hockey 2-way ML (including OT) maps to H -0.5, not H 0.
func TestTwoWayWin1x2Hockey(t *testing.T) {
	period := entity.PeriodData{
		Win1x2: entity.Win1x2Struct{
			Win1: entity.Odd{Value: 1.65},
			Win2: entity.Odd{Value: 2.30},
			// WinNone = 0 → 2-way (no draw)
		},
	}

	// Hockey: 2-way ML = "including OT" → H -0.5 (not H 0)
	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Hockey")
	if _, ok := canon["H1 0"]; ok {
		t.Fatal("Hockey 2-way ML should NOT map to H1 0 (it includes OT, not draw=push)")
	}
	if _, ok := canon["H1 -0.5"]; !ok {
		t.Fatal("Hockey 2-way ML should map to H1 -0.5 (outright win including OT)")
	}
	if _, ok := canon["H2 -0.5"]; !ok {
		t.Fatal("Hockey 2-way ML should map to H2 -0.5")
	}

	// Donor side
	markets := extractAllDonorMarkets(period, 0, 0, 0, "Hockey")
	for _, m := range markets {
		if m.OriginalKey == "1" && m.CanonicalKey != "H1 -0.5" {
			t.Fatalf("Hockey donor: expected H1 -0.5, got %s", m.CanonicalKey)
		}
		if m.OriginalKey == "2" && m.CanonicalKey != "H2 -0.5" {
			t.Fatalf("Hockey donor: expected H2 -0.5, got %s", m.CanonicalKey)
		}
	}
}

// TestTwoWayWin1x2Handball verifies Handball 2-way ML (draw=push) maps to H 0.
func TestTwoWayWin1x2Handball(t *testing.T) {
	period := entity.PeriodData{
		Win1x2: entity.Win1x2Struct{
			Win1: entity.Odd{Value: 1.50},
			Win2: entity.Odd{Value: 2.60},
			// WinNone = 0 → 2-way
		},
	}

	// Handball: 2-way ML = "draw = push" → H 0
	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Handball")
	if _, ok := canon["H1 0"]; !ok {
		t.Fatal("Handball 2-way ML should map to H1 0 (draw=push)")
	}
	if _, ok := canon["H2 0"]; !ok {
		t.Fatal("Handball 2-way ML should map to H2 0 (draw=push)")
	}

	// Donor side
	markets := extractAllDonorMarkets(period, 0, 0, 0, "Handball")
	for _, m := range markets {
		if m.OriginalKey == "1" && m.CanonicalKey != "H1 0" {
			t.Fatalf("Handball donor: expected H1 0, got %s", m.CanonicalKey)
		}
		if m.OriginalKey == "2" && m.CanonicalKey != "H2 0" {
			t.Fatalf("Handball donor: expected H2 0, got %s", m.CanonicalKey)
		}
	}
}

// TestTwoWayWin1x2Basketball verifies Basketball 2-way ML maps to H -0.5 (same as hockey).
func TestTwoWayWin1x2Basketball(t *testing.T) {
	period := entity.PeriodData{
		Win1x2: entity.Win1x2Struct{
			Win1: entity.Odd{Value: 1.80},
			Win2: entity.Odd{Value: 2.05},
		},
	}

	canon := canonicalizePinnacleMarkets(period, 0, 0, 0, "Basketball")
	if _, ok := canon["H1 0"]; ok {
		t.Fatal("Basketball 2-way ML should NOT map to H1 0")
	}
	if _, ok := canon["H1 -0.5"]; !ok {
		t.Fatal("Basketball 2-way ML should map to H1 -0.5")
	}
}
