[Unit]
Description=Persistent Qwen Ollama tunnel from dev to serverforvovka
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:11434:127.0.0.1:11434 serverforvovka
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
