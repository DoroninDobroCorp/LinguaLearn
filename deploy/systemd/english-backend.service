[Unit]
Description=LinguaLearn English Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/LinguaLearn/english
EnvironmentFile=-/srv/secrets/lingualearn-capture.env
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
