<Window x:Class="LinguaLearnAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaLearn Windows Desktop Agent" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LinguaLearn Windows Desktop Agent" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

        <GroupBox Header="Device Token Pairing" Grid.Row="1" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <TextBlock Text="Device Token (Bearer ll_dev_...):" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DeviceTokenTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                    <Button x:Name="SaveTokenButton" Content="Save Token" Grid.Column="1" Margin="10,0,0,0" Width="100" Click="SaveTokenButton_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Capture &amp; Privacy Controls" Grid.Row="2" Margin="0,0,0,15" Padding="10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause Capture" VerticalAlignment="Center" Click="PauseCaptureCheckBox_Click"/>
                <CheckBox x:Name="PreviewModeCheckBox" Content="Preview Hotkey Mode (Ctrl+Alt+P)" Margin="20,0,0,0" VerticalAlignment="Center" Click="PreviewModeCheckBox_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Offline Retry Queue" Grid.Row="3" Margin="0,0,0,15" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="QueueCountTextBlock" Text="Pending items: 0" VerticalAlignment="Center"/>
                <Button x:Name="RetryNowButton" Content="Retry Sync Now" Margin="20,0,0,0" Width="120" Click="RetryNowButton_Click"/>
            </StackPanel>
        </GroupBox>

        <TextBox x:Name="LogTextBox" Grid.Row="4" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Text="Agent initialized. Monitoring edit controls...&#x0a;"/>
    </Grid>
</Window>
