<Window x:Class="LinguaLearnAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaLearn Windows Desktop Agent" Height="640" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LinguaLearn Windows Desktop Agent" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

        <GroupBox Header="API Configuration (HTTPS)" Grid.Row="1" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <TextBlock Text="HTTPS API URL (e.g. https://145.239.82.124.sslip.io/english):" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiUrlTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                    <Button x:Name="SaveApiUrlButton" Content="Save API URL" Grid.Column="1" Margin="10,0,0,0" Width="100" Click="SaveApiUrlButton_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Device Token Pairing" Grid.Row="2" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <TextBlock Text="Device Token (Bearer ll_dev_... stored via DPAPI):" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DeviceTokenTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                    <Button x:Name="SaveTokenButton" Content="Save Token" Grid.Column="1" Margin="10,0,0,0" Width="100" Click="SaveTokenButton_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Capture &amp; Privacy Controls" Grid.Row="3" Margin="0,0,0,15" Padding="10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause Capture" VerticalAlignment="Center" Click="PauseCaptureCheckBox_Click"/>
                <CheckBox x:Name="PreviewModeCheckBox" Content="Preview Hotkey Mode (Ctrl+Alt+P)" Margin="20,0,0,0" VerticalAlignment="Center" Click="PreviewModeCheckBox_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Offline Retry Queue (DPAPI Encrypted)" Grid.Row="4" Margin="0,0,0,15" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="QueueCountTextBlock" Text="Pending items: 0" VerticalAlignment="Center"/>
                <Button x:Name="RetryNowButton" Content="Retry Sync Now" Margin="20,0,0,0" Width="120" Click="RetryNowButton_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Diagnostics &amp; Test Connection" Grid.Row="5" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppVersionTextBlock" Text="App Version: 1.0.0" Grid.Column="0"/>
                    <TextBlock x:Name="ConfiguredUrlTextBlock" Text="Configured URL: -" Grid.Column="1"/>
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackendCommitTextBlock" Text="Backend Commit: Not tested" Grid.Column="0"/>
                    <TextBlock x:Name="AuthStatusTextBlock" Text="Auth Status: Unknown" Grid.Column="1"/>
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeviceTokenStatusTextBlock" Text="Device Token: None" Grid.Column="0"/>
                    <TextBlock x:Name="SyncStatusTextBlock" Text="Sync Status: Idle" Grid.Column="1"/>
                </Grid>
                <Button x:Name="TestConnectionButton" Content="Test Connection" Width="140" HorizontalAlignment="Left" Margin="0,5,0,0" Click="TestConnectionButton_Click"/>
            </StackPanel>
        </GroupBox>

        <TextBox x:Name="LogTextBox" Grid.Row="6" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Text="Agent initialized. Monitoring edit controls...&#x0a;"/>
    </Grid>
</Window>
